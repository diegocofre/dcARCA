<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Authors>Diego Cofré Sistemas</Authors>
    <Company>Diego Cofré Sistemas</Company>
    <PackageProjectUrl>https://www.diegocofre.com.ar</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <!-- Usada por dcArcaAuthService para firmar el TRA (SignedCms/CmsSigner) al armar el CMS/PKCS7 del login WSAA.
         Antes llegaba transitivamente vía System.Security.Cryptography.Xml (paquete con vulnerabilidades NU1903, removido). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Excluir archivos de documentación y ejemplos de ARCA (carpeta docuArca) -->
    <Compile Remove="docuArca/**/*.cs" />
    <EmbeddedResource Remove="docuArca/**/*" />
    <None Remove="docuArca/**/*" />
  </ItemGroup>

</Project>